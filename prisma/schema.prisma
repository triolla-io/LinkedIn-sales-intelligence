generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SALESPERSON
  ADMIN
  SUPER_ADMIN
}

enum Seniority {
  C_LEVEL
  VP
  DIRECTOR
  MANAGER
  IC
  OTHER
}

enum Function {
  ENGINEERING
  HR
  SALES
  MARKETING
  FINANCE
  PRODUCT
  OPERATIONS
  LEGAL
  OTHER
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  PAUSED
  CANCELLED
}

enum ImportJobStatus {
  QUEUED
  PROCESSING
  DONE
  ERROR
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  DISCONNECTED
}

// ─── Models ──────────────────────────────────────────────────────────────────

// ─── NextAuth required models ────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application models ──────────────────────────────────────────────────────

model Organization {
  id                  String   @id @default(cuid())
  name                String
  syncCadenceDays     Int      @default(3)
  monthlyApolloBudget Int      @default(500)
  jobCheckEnabled     Boolean  @default(false)
  createdAt           DateTime @default(now())

  users             User[]
  enrichmentSpends  EnrichmentSpend[]
  invites           Invite[]
  personEnrichments PersonEnrichment[]
}

model User {
  id            String    @id @default(cuid())
  orgId         String
  email         String    @unique
  emailVerified DateTime?
  name          String
  image         String?
  title         String?
  role          Role      @default(SALESPERSON)
  timezone        String    @default("Asia/Jerusalem")
  emailSignature  String?   @db.Text
  routineConnectionsEnabled Boolean @default(true)
  createdAt       DateTime  @default(now())

  org             Organization      @relation(fields: [orgId], references: [id])
  accounts        Account[]
  sessions        Session[]
  contacts        Contact[]
  sentMessages    SentMessage[]     @relation("SentBySender")
  actedMessages   SentMessage[]     @relation("ActedByActor")
  savedViews      SavedView[]
  templates       MessageTemplate[]
  auditActed      AuditEvent[]      @relation("AuditActor")
  auditTargeted   AuditEvent[]      @relation("AuditTarget")
  campaigns       Campaign[]
  imports         Import[]
  importJobs      ImportJob[]
  contactLists    ContactList[]
  linkedinSession  LinkedinSession?
  sequences        Sequence[]
  extensionTasks   ExtensionTask[]   @relation("UserExtensionTasks")
  extensionSession ExtensionSession? @relation("UserExtensionSession")
  extensionAlerts  ExtensionAlert[]  @relation("UserExtensionAlerts")
  prospectingRuns    ProspectingRun[]    @relation("UserProspectingRuns")
  connectionRequests ConnectionRequest[] @relation("UserConnectionRequests")
}

model Contact {
  id               String     @id @default(cuid())
  ownerId          String
  linkedinUrn      String
  linkedinUrl      String
  fullName         String
  hebrewFirstName  String?
  headline         String?
  currentTitle     String?
  currentCompany   String?
  currentCompanyId String?
  companySize      Int?
  seniority        Seniority?
  function         Function?
  location         String?
  industry         String?
  profilePicUrl    String?
  connectedAt      DateTime?
  lastSyncedAt     DateTime
  removedAt        DateTime?

  // enrichment
  email            String?
  phone            String?
  enrichedAt       DateTime?
  enrichmentSource String?
  manualFields     String[]  @default([])
  enrichmentLog    Json?
  enrichmentRanAt  DateTime?
  enrichmentError  String?
  hubspotSyncedAt  DateTime?

  // job change detection
  jobSnapshotTitle   String?
  jobSnapshotCompany String?
  lastJobCheckAt     DateTime?
  jobChanges         ContactJobChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messages            SentMessage[]
  campaignRecipients  CampaignRecipient[]
  lists               ContactListMember[]
  sequenceEnrollments SequenceEnrollment[]

  @@unique([ownerId, linkedinUrn])
  @@index([ownerId, seniority])
  @@index([ownerId, function])
  @@index([ownerId, companySize])
  @@index([ownerId, removedAt])
  @@index([ownerId, companyId])
}

model MessageTemplate {
  id      String  @id @default(cuid())
  ownerId String
  orgId   String?
  name    String
  body    String

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messages      SentMessage[]
  campaigns     Campaign[]
  sequenceSteps SequenceStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SentMessage {
  id           String        @id @default(cuid())
  senderId     String
  actorId      String
  contactId    String
  templateId   String?
  body         String
  sentAt       DateTime      @default(now())
  status       MessageStatus @default(QUEUED)
  errorMessage String?
  externalId   String?
  metadata     Json?

  sender                User                   @relation("SentBySender", fields: [senderId], references: [id])
  actor                 User                   @relation("ActedByActor", fields: [actorId], references: [id])
  contact               Contact                @relation(fields: [contactId], references: [id])
  template              MessageTemplate?       @relation(fields: [templateId], references: [id])
  campaignRecipient     CampaignRecipient?
  sequenceStepExecution SequenceStepExecution?

  @@index([senderId, sentAt])
  @@index([contactId])
}

model SavedView {
  id         String   @id @default(cuid())
  ownerId    String
  orgId      String?
  name       String
  filterJson Json
  createdAt  DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id           String   @id @default(cuid())
  actorId      String
  targetUserId String?
  action       String
  payload      Json
  createdAt    DateTime @default(now())

  actor  User  @relation("AuditActor", fields: [actorId], references: [id])
  target User? @relation("AuditTarget", fields: [targetUserId], references: [id])

  @@index([targetUserId])
  @@index([actorId])
  @@index([createdAt])
}

model EnrichmentSpend {
  id      String @id @default(cuid())
  orgId   String
  month   String // "YYYY-MM"
  credits Int    @default(0)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, month])
}

model PersonEnrichment {
  id                    String   @id @default(cuid())
  orgId                 String
  linkedinUrlNormalized String
  email                 String?
  phone                 String?
  companySize           Int?
  currentCompany        String?
  industry              String?
  rawResponse           Json?
  enrichedByContactId   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, linkedinUrlNormalized])
  @@index([orgId])
}

model LinkedinSession {
  id              String        @id @default(cuid())
  userId          String        @unique
  encryptedCookie String
  cookieExpiresAt DateTime?
  lastValidatedAt DateTime?
  status          SessionStatus @default(DISCONNECTED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id             String    @id @default(cuid())
  universalName  String    @unique // slug used to look up via Voyager (e.g. "microsoft")
  name           String
  industry       String?
  vertical       String?
  staffCount     Int? // exact headcount from Voyager (e.g. 231227)
  website        String?
  description    String?   @db.Text
  lastEnrichedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  contacts Contact[]

  @@index([industry])
  @@index([staffCount])
}

// ─── Campaign enums ───────────────────────────────────────────────────────────

enum CampaignChannel {
  LINKEDIN
  EMAIL
  WHATSAPP
  VOICE
}

enum CampaignStatus {
  DRAFT
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum RecipientStatus {
  PENDING
  QUEUED
  SENDING
  SENT
  FAILED
  SKIPPED
  REPLIED
}

enum SequenceStatus {
  DRAFT
  QUEUED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  UNSUBSCRIBED
}

enum ExtensionTaskKind {
  SEND
  CHECK_REPLY
  SEARCH
  CONNECT
}

enum ExtensionTaskStatus {
  PENDING
  CLAIMED
  DONE
  FAILED
}

enum ExtensionAlertKind {
  OFFLINE
  CHECKPOINT
}

enum ProspectingRunStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

enum ConnectionRequestStatus {
  DISCOVERED
  QUEUED
  SENT
  FAILED
  SKIPPED
  ACCEPTED
}

enum ProspectingEventType {
  DISCOVERED
  SKIPPED
  QUEUED
  SCHEDULED
  QUOTA_DEFERRED
  SEND_ATTEMPT
  SENT
  FAILED
  ALREADY_PENDING
  ALREADY_CONNECTED
  CHECKPOINT
}

// ─── Campaign models ──────────────────────────────────────────────────────────

model Campaign {
  id          String          @id @default(cuid())
  ownerId     String
  orgId       String?
  name        String
  channel     CampaignChannel
  templateId  String
  status      CampaignStatus  @default(DRAFT)
  filterJson  Json?
  dailyLimit  Int?
  subject     String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner      User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  template   MessageTemplate     @relation(fields: [templateId], references: [id])
  recipients CampaignRecipient[]

  @@index([ownerId, status])
}

model CampaignRecipient {
  id            String          @id @default(cuid())
  campaignId    String
  contactId     String
  status        RecipientStatus @default(PENDING)
  renderedBody  String?
  sentMessageId String?         @unique
  errorMessage  String?
  attemptCount  Int             @default(0)
  scheduledAt   DateTime?
  sentAt        DateTime?

  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact     Contact      @relation(fields: [contactId], references: [id])
  sentMessage SentMessage? @relation(fields: [sentMessageId], references: [id])

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
}

model Invite {
  id        String    @id @default(cuid())
  orgId     String
  email     String
  token     String    @unique
  role      Role      @default(SALESPERSON)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([orgId])
}

model Import {
  id           String   @id @default(cuid())
  ownerId      String
  fileName     String
  totalRows    Int // raw rows in the uploaded file
  added        Int // contacts that did not previously exist
  updated      Int // contacts that existed and were refreshed
  removed      Int // contacts present in DB but absent from this CSV (soft-removed)
  companies    Int // unique non-empty company strings in this CSV
  newCompanies Int // companies created (didn't exist in DB before this import)
  createdAt    DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
}

model ImportJob {
  id           String          @id @default(cuid())
  ownerId      String
  fileName     String
  status       ImportJobStatus @default(QUEUED)
  updateOnly   Boolean         @default(false)
  stage        String          @default("queued")
  total        Int             @default(0)
  processed    Int             @default(0)
  payload      Json
  error        String?
  added        Int @default(0)
  updated      Int @default(0)
  removed      Int @default(0)
  unchanged    Int @default(0)
  companies    Int @default(0)
  newCompanies Int @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@index([ownerId, createdAt])
}

model ContactList {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members   ContactListMember[]
  sequences Sequence[]

  @@index([ownerId])
  @@unique([ownerId, name])
}

model ContactListMember {
  listId    String
  contactId String
  addedAt   DateTime @default(now())

  list    ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
  @@index([contactId])
}

// ─── Sequence models ──────────────────────────────────────────────────────────

model Sequence {
  id            String         @id @default(cuid())
  ownerId       String
  orgId         String?
  name          String
  contactListId String?
  status        SequenceStatus @default(DRAFT)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  owner       User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  contactList ContactList?          @relation(fields: [contactListId], references: [id], onDelete: SetNull)
  steps       SequenceStep[]
  enrollments SequenceEnrollment[]

  @@index([ownerId, status])
}

model SequenceStep {
  id         String          @id @default(cuid())
  sequenceId String
  stepNumber Int
  dayOffset  Int
  sendHour   Int             @default(9)
  sendMinute Int             @default(0)
  sendHourEnd Int?
  channel    CampaignChannel
  templateId String
  subject    String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  sequence   Sequence                @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  template   MessageTemplate         @relation(fields: [templateId], references: [id])
  executions SequenceStepExecution[]

  @@unique([sequenceId, stepNumber])
  @@index([sequenceId])
}

model SequenceEnrollment {
  id         String           @id @default(cuid())
  sequenceId String
  contactId  String
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())

  sequence   Sequence                @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact    Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  executions SequenceStepExecution[]

  @@unique([sequenceId, contactId])
  @@index([sequenceId, status])
}

model SequenceStepExecution {
  id            String          @id @default(cuid())
  enrollmentId  String
  stepId        String
  status        RecipientStatus @default(PENDING)
  scheduledAt   DateTime
  sentAt        DateTime?
  renderedBody  String?
  errorMessage  String?
  attemptCount  Int             @default(0)
  sentMessageId String?         @unique
  updatedAt     DateTime        @updatedAt

  enrollment  SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step        SequenceStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  sentMessage SentMessage?       @relation(fields: [sentMessageId], references: [id])

  @@unique([enrollmentId, stepId])
  @@index([status, scheduledAt])
}

// ─── Extension models ─────────────────────────────────────────────────────────

model ExtensionTask {
  id                  String              @id @default(cuid())
  userId              String
  user                User                @relation("UserExtensionTasks", fields: [userId], references: [id], onDelete: Cascade)
  kind                ExtensionTaskKind
  status              ExtensionTaskStatus @default(PENDING)
  payload             Json
  // Polymorphic: CampaignRecipient.id (kind=SEND) or SequenceStepExecution.id (kind=CHECK_REPLY). No FK enforced by design.
  recipientId         String?
  sequenceExecutionId String?
  prospectingRunId    String?
  connectionRequestId String?
  scheduledFor        DateTime            @default(now())
  claimedAt           DateTime?
  completedAt         DateTime?
  attemptCount        Int                 @default(0)
  errorCode           String?
  errorMessage        String?
  result              Json?
  createdAt           DateTime            @default(now())

  @@index([userId, status, scheduledFor])
  @@index([recipientId])
}

model ExtensionSession {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation("UserExtensionSession", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  tokenPrefix String
  lastSeenAt  DateTime?
  version     String?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
}

model ExtensionAlert {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation("UserExtensionAlerts", fields: [userId], references: [id], onDelete: Cascade)
  kind       ExtensionAlertKind
  message    String
  createdAt  DateTime           @default(now())
  resolvedAt DateTime?

  @@index([userId, resolvedAt])
}

model NameTranslation {
  firstName       String   @id
  hebrewFirstName String
  createdAt       DateTime @default(now())
}

model ProspectingRun {
  id              String               @id @default(cuid())
  ownerId         String
  owner           User                 @relation("UserProspectingRuns", fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  keywords        String
  geoUrn          String               @default("101620260")
  industryIds     String[]             @default([])
  searchUrl       String
  status          ProspectingRunStatus @default(DRAFT)
  dailyCap        Int                  @default(15)
  weeklyCap       Int                  @default(100)
  sendHoursStart  Int                  @default(9)
  sendHoursEnd    Int                  @default(18)
  sendDays        Int[]
  discoveryDone   Boolean              @default(false)
  connectInFlight Boolean              @default(false)
  searchFailCount Int                  @default(0)
  pausedUntil     DateTime?
  nextDiscoveryAt DateTime?
  nextSearchPage  Int                  @default(1)
  totalDiscovered Int                  @default(0)
  totalSent       Int                  @default(0)
  createdAt       DateTime             @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  requests        ConnectionRequest[]
  events          ProspectingEvent[]

  @@index([ownerId, status])
}

model ConnectionRequest {
  id             String                  @id @default(cuid())
  ownerId        String
  owner          User                    @relation("UserConnectionRequests", fields: [ownerId], references: [id], onDelete: Cascade)
  runId          String
  run            ProspectingRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  linkedinUrn    String
  linkedinUrl    String
  fullName       String?
  headline       String?
  currentTitle   String?
  currentCompany String?
  location       String?
  status         ConnectionRequestStatus @default(DISCOVERED)
  skipReason     String?
  cardAction     String?
  sendPriority   Int                     @default(0)
  sentAt         DateTime?
  attemptCount   Int                     @default(0)
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime                @default(now())

  @@unique([ownerId, linkedinUrn])
  @@index([runId, status])
  @@index([ownerId, status])
}

model ProspectingEvent {
  id                  String               @id @default(cuid())
  runId               String
  run                 ProspectingRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  connectionRequestId String?
  type                ProspectingEventType
  message             String?
  detail              Json?
  createdAt           DateTime             @default(now())

  @@index([runId, createdAt])
  @@index([connectionRequestId])
}

// ─── Job change detection ──────────────────────────────────────────────────────

model ContactJobChange {
  id          String   @id @default(cuid())
  contactId   String
  detectedAt  DateTime @default(now())
  prevTitle   String?
  newTitle    String?
  prevCompany String?
  newCompany  String?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}
