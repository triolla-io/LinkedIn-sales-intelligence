generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SALESPERSON
  ADMIN
  SUPER_ADMIN
}

enum Seniority {
  C_LEVEL
  VP
  DIRECTOR
  MANAGER
  IC
  OTHER
}

enum Function {
  ENGINEERING
  HR
  SALES
  MARKETING
  FINANCE
  PRODUCT
  OPERATIONS
  LEGAL
  OTHER
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  PAUSED
  CANCELLED
}

enum ImportJobStatus {
  QUEUED
  PROCESSING
  DONE
  ERROR
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  DISCONNECTED
}

// ─── Models ──────────────────────────────────────────────────────────────────

// ─── NextAuth required models ────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application models ──────────────────────────────────────────────────────

model Organization {
  id                          String   @id @default(cuid())
  name                        String
  syncCadenceDays             Int      @default(3)
  monthlyApolloBudget         Int      @default(500)
  /// Per-user monthly Apollo credit quota. Enforced IN ADDITION to
  /// monthlyApolloBudget (the shared org pool), so one user cannot drain it.
  perUserMonthlyApolloCredits Int      @default(1000)
  jobCheckEnabled             Boolean  @default(false)
  companySignalsEnabled       Boolean  @default(false)
  fintechRadarEnabled         Boolean  @default(false)
  techRadarEnabled            Boolean  @default(false)
  /// Gates the SCHEDULED tick only. `techRadarEnabled` means the module exists —
  /// population runs, the screen is visible, a manual scan can be triggered. This
  /// second flag is what lets the cron fire, and it is turned on only after a
  /// human has reviewed a hand-triggered batch.
  radarScheduleEnabled        Boolean  @default(false)
  createdAt                   DateTime @default(now())

  users             User[]
  enrichmentSpends  EnrichmentSpend[]
  invites           Invite[]
  personEnrichments PersonEnrichment[]
  trackedCompanies  TrackedCompany[]
}

model User {
  id                        String    @id @default(cuid())
  orgId                     String
  email                     String    @unique
  emailVerified             DateTime?
  name                      String
  image                     String?
  title                     String?
  role                      Role      @default(SALESPERSON)
  timezone                  String    @default("Asia/Jerusalem")
  emailSignature            String?   @db.Text
  routineConnectionsEnabled Boolean   @default(true)
  /// Warm-up anchor for gentle connect pacing: first successful connection send (or admin reset).
  connectWarmupStartedAt    DateTime?
  createdAt                 DateTime  @default(now())

  org                 Organization           @relation(fields: [orgId], references: [id])
  accounts            Account[]
  sessions            Session[]
  contacts            Contact[]
  sentMessages        SentMessage[]          @relation("SentBySender")
  actedMessages       SentMessage[]          @relation("ActedByActor")
  savedViews          SavedView[]
  templates           MessageTemplate[]
  auditActed          AuditEvent[]           @relation("AuditActor")
  auditTargeted       AuditEvent[]           @relation("AuditTarget")
  campaigns           Campaign[]
  imports             Import[]
  importJobs          ImportJob[]
  contactLists        ContactList[]
  linkedinSession     LinkedinSession?
  sequences           Sequence[]
  extensionTasks      ExtensionTask[]        @relation("UserExtensionTasks")
  extensionSession    ExtensionSession?      @relation("UserExtensionSession")
  extensionAlerts     ExtensionAlert[]       @relation("UserExtensionAlerts")
  prospectingRuns     ProspectingRun[]       @relation("UserProspectingRuns")
  connectionRequests  ConnectionRequest[]    @relation("UserConnectionRequests")
  mcpTokens           McpAccessToken[]
  companySignalDrafts CompanySignalDraft[]   @relation("UserCompanySignalDrafts")
  enrichmentSpends    UserEnrichmentSpend[]  @relation("UserEnrichmentSpends")
  techDrafts          TechOpportunityDraft[] @relation("UserTechOpportunityDrafts")
}

model Contact {
  id               String     @id @default(cuid())
  ownerId          String
  linkedinUrn      String
  linkedinUrl      String
  fullName         String
  hebrewFirstName  String?
  headline         String?
  currentTitle     String?
  currentCompany   String?
  currentCompanyId String?
  companySize      Int?
  seniority        Seniority?
  function         Function?
  location         String?
  industry         String?
  profilePicUrl    String?
  connectedAt      DateTime?
  lastSyncedAt     DateTime
  removedAt        DateTime?

  // enrichment
  email            String?
  phone            String?
  enrichedAt       DateTime?
  enrichmentSource String?
  manualFields     String[]  @default([])
  enrichmentLog    Json?
  enrichmentRanAt  DateTime?
  enrichmentError  String?
  hubspotSyncedAt  DateTime?

  // job change detection
  jobSnapshotTitle   String?
  jobSnapshotCompany String?
  lastJobCheckAt     DateTime?
  jobChanges         ContactJobChange[]

  /// Radar cohort override. null = follow the cohort rule (C-level at a 50-200
  /// person company); true = always include, even outside the cohort (this is how
  /// a handful of people at giants get cultivated); false = never include.
  radarInclude Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  owner               User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messages            SentMessage[]
  campaignRecipients  CampaignRecipient[]
  lists               ContactListMember[]
  companySignalDrafts CompanySignalDraft[]
  sequenceEnrollments SequenceEnrollment[]
  articleMatches      ArticleMatch[]
  techDrafts          TechOpportunityDraft[]

  @@unique([ownerId, linkedinUrn])
  @@index([ownerId, seniority])
  @@index([ownerId, function])
  @@index([ownerId, companySize])
  @@index([ownerId, removedAt])
  @@index([ownerId, companyId])
}

model MessageTemplate {
  id      String  @id @default(cuid())
  ownerId String
  orgId   String?
  name    String
  body    String

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messages      SentMessage[]
  campaigns     Campaign[]
  sequenceSteps SequenceStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SentMessage {
  id           String        @id @default(cuid())
  senderId     String
  actorId      String
  contactId    String
  templateId   String?
  body         String
  sentAt       DateTime      @default(now())
  status       MessageStatus @default(QUEUED)
  errorMessage String?
  externalId   String?
  metadata     Json?

  sender                User                   @relation("SentBySender", fields: [senderId], references: [id])
  actor                 User                   @relation("ActedByActor", fields: [actorId], references: [id])
  contact               Contact                @relation(fields: [contactId], references: [id])
  template              MessageTemplate?       @relation(fields: [templateId], references: [id])
  campaignRecipient     CampaignRecipient?
  sequenceStepExecution SequenceStepExecution?

  @@index([senderId, sentAt])
  @@index([contactId])
}

model SavedView {
  id         String   @id @default(cuid())
  ownerId    String
  orgId      String?
  name       String
  filterJson Json
  createdAt  DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id           String   @id @default(cuid())
  actorId      String
  targetUserId String?
  action       String
  payload      Json
  createdAt    DateTime @default(now())

  actor  User  @relation("AuditActor", fields: [actorId], references: [id])
  target User? @relation("AuditTarget", fields: [targetUserId], references: [id])

  @@index([targetUserId])
  @@index([actorId])
  @@index([createdAt])
}

model McpAccessToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique // sha256 hex of the raw token
  label      String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EnrichmentSpend {
  id      String @id @default(cuid())
  orgId   String
  month   String // "YYYY-MM"
  credits Int    @default(0)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, month])
}

/// Per-user Apollo credit spend for a month. Incremented in the SAME transaction
/// as EnrichmentSpend (the org pool counter) so the two can never drift.
/// Credits are charged to the contact's OWNER, not the acting admin.
model UserEnrichmentSpend {
  id      String @id @default(cuid())
  userId  String
  orgId   String
  month   String // "YYYY-MM"
  credits Int    @default(0)

  user User @relation("UserEnrichmentSpends", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([orgId, month])
}

model PersonEnrichment {
  id                    String   @id @default(cuid())
  orgId                 String
  linkedinUrlNormalized String
  email                 String?
  phone                 String?
  companySize           Int?
  currentCompany        String?
  industry              String?
  rawResponse           Json?
  enrichedByContactId   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, linkedinUrlNormalized])
  @@index([orgId])
}

model LinkedinSession {
  id              String        @id @default(cuid())
  userId          String        @unique
  encryptedCookie String
  cookieExpiresAt DateTime?
  lastValidatedAt DateTime?
  status          SessionStatus @default(DISCONNECTED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id                String    @id @default(cuid())
  universalName     String    @unique // slug used to look up via Voyager (e.g. "microsoft")
  name              String
  industry          String?
  vertical          String?
  staffCount        Int? // exact headcount from Voyager (e.g. 231227)
  website           String?
  description       String?   @db.Text
  lastEnrichedAt    DateTime?
  lastSignalCheckAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  contacts         Contact[]
  companySignals   CompanySignal[]
  trackedCompanies TrackedCompany[]

  @@index([industry])
  @@index([staffCount])
}

// ─── Campaign enums ───────────────────────────────────────────────────────────

enum CampaignChannel {
  LINKEDIN
  EMAIL
  WHATSAPP
  VOICE
}

enum CampaignStatus {
  DRAFT
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum RecipientStatus {
  PENDING
  QUEUED
  SENDING
  SENT
  FAILED
  SKIPPED
  REPLIED
}

enum SequenceStatus {
  DRAFT
  QUEUED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  UNSUBSCRIBED
}

enum JobChangeStatus {
  PENDING_REVIEW
  APPROVED
  SENT
  DISMISSED
}

enum JobChangeType {
  COMPANY_MOVE
  PROMOTION
  TITLE_CHANGE
}

enum ExtensionTaskKind {
  SEND
  CHECK_REPLY
  SEARCH
  CONNECT
  RESOLVE_COMPANY
  SCRAPE_PROFILE
  PREPARE_MESSAGE
  SCRAPE_CONNECTIONS
}

enum ExtensionTaskStatus {
  PENDING
  CLAIMED
  DONE
  FAILED
  CANCELLED
}

enum ExtensionAlertKind {
  OFFLINE
  CHECKPOINT
}

enum ProspectingRunStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

enum ConnectionRequestStatus {
  DISCOVERED
  QUEUED
  SENT
  FAILED
  SKIPPED
  ACCEPTED
}

enum ProspectingEventType {
  DISCOVERED
  SKIPPED
  QUEUED
  SCHEDULED
  QUOTA_DEFERRED
  SEND_ATTEMPT
  SENT
  FAILED
  ALREADY_PENDING
  ALREADY_CONNECTED
  ACCEPTED
  CHECKPOINT
  COMPLETED
}

// ─── Campaign models ──────────────────────────────────────────────────────────

model Campaign {
  id          String          @id @default(cuid())
  ownerId     String
  orgId       String?
  name        String
  channel     CampaignChannel
  templateId  String
  status      CampaignStatus  @default(DRAFT)
  filterJson  Json?
  dailyLimit  Int?
  subject     String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner      User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  template   MessageTemplate     @relation(fields: [templateId], references: [id])
  recipients CampaignRecipient[]

  @@index([ownerId, status])
}

model CampaignRecipient {
  id            String          @id @default(cuid())
  campaignId    String
  contactId     String
  status        RecipientStatus @default(PENDING)
  renderedBody  String?
  sentMessageId String?         @unique
  errorMessage  String?
  attemptCount  Int             @default(0)
  scheduledAt   DateTime?
  sentAt        DateTime?

  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact     Contact      @relation(fields: [contactId], references: [id])
  sentMessage SentMessage? @relation(fields: [sentMessageId], references: [id])

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
}

model Invite {
  id        String    @id @default(cuid())
  orgId     String
  email     String
  token     String    @unique
  role      Role      @default(SALESPERSON)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([orgId])
}

model Import {
  id           String   @id @default(cuid())
  ownerId      String
  fileName     String
  totalRows    Int // raw rows in the uploaded file
  added        Int // contacts that did not previously exist
  updated      Int // contacts that existed and were refreshed
  removed      Int // contacts present in DB but absent from this CSV (soft-removed)
  companies    Int // unique non-empty company strings in this CSV
  newCompanies Int // companies created (didn't exist in DB before this import)
  createdAt    DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
}

model ImportJob {
  id           String          @id @default(cuid())
  ownerId      String
  fileName     String
  status       ImportJobStatus @default(QUEUED)
  updateOnly   Boolean         @default(false)
  stage        String          @default("queued")
  total        Int             @default(0)
  processed    Int             @default(0)
  payload      Json
  error        String?
  added        Int             @default(0)
  updated      Int             @default(0)
  removed      Int             @default(0)
  unchanged    Int             @default(0)
  companies    Int             @default(0)
  newCompanies Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@index([ownerId, createdAt])
}

model ContactList {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members   ContactListMember[]
  sequences Sequence[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

model ContactListMember {
  listId    String
  contactId String
  addedAt   DateTime @default(now())

  list    ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
  @@index([contactId])
}

// ─── Sequence models ──────────────────────────────────────────────────────────

model Sequence {
  id            String         @id @default(cuid())
  ownerId       String
  orgId         String?
  name          String
  contactListId String?
  status        SequenceStatus @default(DRAFT)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  owner       User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  contactList ContactList?         @relation(fields: [contactListId], references: [id], onDelete: SetNull)
  steps       SequenceStep[]
  enrollments SequenceEnrollment[]

  @@index([ownerId, status])
}

model SequenceStep {
  id            String          @id @default(cuid())
  sequenceId    String
  stepNumber    Int
  dayOffset     Int
  sendHour      Int             @default(9)
  sendMinute    Int             @default(0)
  sendHourEnd   Int?
  // Minute offset within the (optional) end hour — half-hour window ends like 21:30.
  sendMinuteEnd Int             @default(0)
  channel       CampaignChannel
  templateId    String
  subject       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  sequence   Sequence                @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  template   MessageTemplate         @relation(fields: [templateId], references: [id])
  executions SequenceStepExecution[]

  @@unique([sequenceId, stepNumber])
  @@index([sequenceId])
}

model SequenceEnrollment {
  id         String           @id @default(cuid())
  sequenceId String
  contactId  String
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())

  sequence   Sequence                @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact    Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  executions SequenceStepExecution[]

  @@unique([sequenceId, contactId])
  @@index([sequenceId, status])
}

model SequenceStepExecution {
  id            String          @id @default(cuid())
  enrollmentId  String
  stepId        String
  status        RecipientStatus @default(PENDING)
  scheduledAt   DateTime
  sentAt        DateTime?
  renderedBody  String?
  errorMessage  String?
  attemptCount  Int             @default(0)
  sentMessageId String?         @unique
  updatedAt     DateTime        @updatedAt

  enrollment  SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step        SequenceStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  sentMessage SentMessage?       @relation(fields: [sentMessageId], references: [id])

  @@unique([enrollmentId, stepId])
  @@index([status, scheduledAt])
}

// ─── Extension models ─────────────────────────────────────────────────────────

model ExtensionTask {
  id                   String              @id @default(cuid())
  userId               String
  user                 User                @relation("UserExtensionTasks", fields: [userId], references: [id], onDelete: Cascade)
  kind                 ExtensionTaskKind
  status               ExtensionTaskStatus @default(PENDING)
  payload              Json
  // Polymorphic: CampaignRecipient.id (kind=SEND) or SequenceStepExecution.id (kind=CHECK_REPLY). No FK enforced by design.
  recipientId          String?
  sequenceExecutionId  String?
  prospectingRunId     String?
  connectionRequestId  String?
  jobChangeId          String?
  companySignalDraftId String?
  articleMatchId       String?
  techDraftId          String?
  scheduledFor         DateTime            @default(now())
  claimedAt            DateTime?
  completedAt          DateTime?
  attemptCount         Int                 @default(0)
  errorCode            String?
  errorMessage         String?
  result               Json?
  createdAt            DateTime            @default(now())

  @@index([userId, status, scheduledFor])
  @@index([recipientId])
}

model ExtensionSession {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation("UserExtensionSession", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  tokenPrefix String
  lastSeenAt  DateTime?
  version     String?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
}

model ExtensionAlert {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation("UserExtensionAlerts", fields: [userId], references: [id], onDelete: Cascade)
  kind       ExtensionAlertKind
  message    String
  createdAt  DateTime           @default(now())
  resolvedAt DateTime?

  @@index([userId, resolvedAt])
}

model NameTranslation {
  firstName       String   @id
  hebrewFirstName String
  createdAt       DateTime @default(now())
}

model ProspectingRun {
  id               String                     @id @default(cuid())
  ownerId          String
  owner            User                       @relation("UserProspectingRuns", fields: [ownerId], references: [id], onDelete: Cascade)
  name             String
  keywords         String
  geoUrn           String                     @default("101620260")
  industryIds      String[]                   @default([])
  searchUrl        String
  targetType       ProspectingTargetType      @default(KEYWORDS)
  status           ProspectingRunStatus       @default(DRAFT)
  dailyCap         Int                        @default(12)
  weeklyCap        Int                        @default(60)
  sendHoursStart   Int                        @default(9)
  sendHoursEnd     Int                        @default(18)
  // Half-hour granularity: minute offset (0 or 30) within the start/end hour, e.g. end 21:30.
  sendMinutesStart Int                        @default(0)
  sendMinutesEnd   Int                        @default(0)
  sendDays         Int[]
  discoveryDone    Boolean                    @default(false)
  connectInFlight  Boolean                    @default(false)
  searchFailCount  Int                        @default(0)
  pausedUntil      DateTime?
  nextDiscoveryAt  DateTime?
  nextSearchPage   Int                        @default(1)
  totalDiscovered  Int                        @default(0)
  totalSent        Int                        @default(0)
  createdAt        DateTime                   @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  requests         ConnectionRequest[]
  events           ProspectingEvent[]
  companyTargets   ProspectingCompanyTarget[]

  @@index([ownerId, status])
}

enum ProspectingTargetType {
  KEYWORDS
  COMPANY
}

model ProspectingCompanyTarget {
  id                String              @id @default(cuid())
  runId             String
  run               ProspectingRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  name              String // display name (English preferred)
  nameHebrew        String?
  linkedinUrl       String? // as provided (sheet column or manual paste)
  linkedinSlug      String? // normalized /company/<slug> — dedup key when URL present
  linkedinCompanyId String? // numeric ID resolved by the extension
  resolvedName      String? // canonical name from LinkedIn (match visibility)
  website           String?
  vertical          String?
  dedupKey          String // linkedinSlug ?? normalized(name) — stored at insert
  status            CompanyTargetStatus @default(PENDING)
  searchPage        Int                 @default(1) // per-company, per-title pagination cursor
  searchTitleIndex  Int                 @default(0) // which title in the run's list is being searched now
  discoveredCount   Int                 @default(0)
  scannedCount      Int                 @default(0) // people LinkedIn returned for this company, matching or not
  sentCount         Int                 @default(0) // denormalized for the companies table UI
  error             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  requests ConnectionRequest[]

  @@unique([runId, dedupKey])
  @@index([runId, status])
}

enum CompanyTargetStatus {
  PENDING // waiting for its turn
  RESOLVING // RESOLVE_COMPANY task in flight
  READY // ID resolved, waiting for search
  SEARCHING // SEARCH task(s) in flight / paginating
  DONE // all pages scraped
  FAILED // resolve/search failed permanently (error set)
  REMOVED // user removed; unsent people cancelled
}

model ConnectionRequest {
  id              String                    @id @default(cuid())
  ownerId         String
  owner           User                      @relation("UserConnectionRequests", fields: [ownerId], references: [id], onDelete: Cascade)
  runId           String
  run             ProspectingRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  companyTargetId String?
  companyTarget   ProspectingCompanyTarget? @relation(fields: [companyTargetId], references: [id], onDelete: SetNull)
  linkedinUrn     String
  linkedinUrl     String
  fullName        String?
  headline        String?
  currentTitle    String?
  currentCompany  String?
  location        String?
  status          ConnectionRequestStatus   @default(DISCOVERED)
  skipReason      String?
  cardAction      String?
  sendPriority    Int                       @default(0)
  sentAt          DateTime?
  acceptedAt      DateTime?
  attemptCount    Int                       @default(0)
  errorCode       String?
  errorMessage    String?
  createdAt       DateTime                  @default(now())

  @@unique([ownerId, linkedinUrn])
  @@index([runId, status])
  @@index([ownerId, status])
  @@index([companyTargetId])
}

model ProspectingEvent {
  id                  String               @id @default(cuid())
  runId               String
  run                 ProspectingRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  connectionRequestId String?
  type                ProspectingEventType
  message             String?
  detail              Json?
  createdAt           DateTime             @default(now())

  @@index([runId, createdAt])
  @@index([connectionRequestId])
}

// ─── Job change detection ──────────────────────────────────────────────────────

model ContactJobChange {
  id           String          @id @default(cuid())
  contactId    String
  detectedAt   DateTime        @default(now())
  prevTitle    String?
  newTitle     String?
  prevCompany  String?
  newCompany   String?
  status       JobChangeStatus @default(PENDING_REVIEW)
  changeType   JobChangeType?
  draftMessage String?
  sentAt       DateTime?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([status])
}

// ─── Company signals ─────────────────────────────────────────────────────────

model CompanySignal {
  id         String               @id @default(cuid())
  companyId  String
  company    Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  signalType CompanySignalType
  title      String
  summary    String               @db.Text
  eventDate  DateTime?
  confidence Float                @default(0)
  sources    Json // [{ name, url, publishedAt }]
  verified   Boolean              @default(false)
  dedupeKey  String
  status     CompanySignalStatus  @default(DETECTED)
  detectedAt DateTime             @default(now())
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  drafts     CompanySignalDraft[]

  @@unique([companyId, dedupeKey])
  @@index([status])
}

model CompanySignalDraft {
  id              String                   @id @default(cuid())
  signalId        String
  signal          CompanySignal            @relation(fields: [signalId], references: [id], onDelete: Cascade)
  ownerId         String
  owner           User                     @relation("UserCompanySignalDrafts", fields: [ownerId], references: [id], onDelete: Cascade)
  contactId       String
  contact         Contact                  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  draftMessage    String                   @db.Text
  emailSubject    String?
  emailBody       String?                  @db.Text
  whatsappMessage String?                  @db.Text
  status          CompanySignalDraftStatus @default(PENDING_REVIEW)
  channel         String                   @default("LINKEDIN")
  sentAt          DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@unique([signalId, contactId])
  @@index([ownerId, status])
}

enum CompanySignalType {
  FUNDING
  HIRING_GROWTH
  OFFICE_MOVE
  PRODUCT_LAUNCH
  AWARD
  MILESTONE
  EXEC_HIRE
}

enum CompanySignalStatus {
  DETECTED
  VERIFIED
  DRAFTED
  ARCHIVED
}

enum CompanySignalDraftStatus {
  PENDING_REVIEW
  APPROVED
  PREPARED
  SENT
  DISMISSED
}

enum ArticleMatchStatus {
  SUGGESTED
  PREPARING
  PREPARED
  DISMISSED
  SENT
}

model FintechArticle {
  id                 String    @id @default(cuid())
  url                String    @unique
  title              String
  summary            String    @db.Text
  topics             String[]  @default([])
  mentionedCompanies String[]  @default([])
  relevantRoles      String[]  @default([])
  source             String
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())

  matches ArticleMatch[]

  @@index([createdAt])
}

model ArticleMatch {
  id           String             @id @default(cuid())
  articleId    String
  contactId    String
  ownerId      String
  score        Float
  reason       String             @db.Text
  draftMessage String?            @db.Text
  status       ArticleMatchStatus @default(SUGGESTED)
  sentChannel  String?
  createdAt    DateTime           @default(now())

  article FintechArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  contact Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([articleId, contactId])
  @@index([ownerId, status])
  @@index([ownerId, createdAt])
}

// ─── Tech Radar ──────────────────────────────────────────────────────────────
//
// Company-driven technology-opportunity radar. Inverts the Fintech Radar
// direction: a curated per-org company list is researched into a profile, the
// profile's derived queries drive the scan, and fit is judged per company.
//
// The entity is split so company-agnostic work happens ONCE: `TechItem` is the
// shared write-up of a technology (what it is), `TechOpportunity` is the
// per-company judgement (why it fits you). Same proven shape as
// FintechArticle + ArticleMatch.

enum TrackedCompanyStatus {
  PENDING_RESEARCH
  ACTIVE
  RESEARCH_FAILED
}

enum TechOpportunityStatus {
  DISCOVERED
  DRAFTED
  ARCHIVED
}

enum TechDraftStatus {
  PENDING_REVIEW
  /// Claimed: a PREPARE_MESSAGE extension task is queued/typing. Guarded transition
  /// out of PENDING_REVIEW so a double-click cannot queue two prepare tasks.
  PREPARING
  PREPARED
  SENT
  DISMISSED
}

/// A company the org has chosen to track. Deliberately NOT an extension of the
/// global `Company` model: `Company` is cross-org and derived automatically from
/// contacts, while this is org-scoped, hand-curated, and carries org-private
/// information (relationship, research profile). `companyId` links to the global
/// row when resolvable so contacts can be found via `Contact.companyId`.
model TrackedCompany {
  id               String               @id @default(cuid())
  orgId            String
  name             String
  /// Extra names to match contacts on. A holding company's people write their employer
  /// many ways ("Delek Group", "Delek", "Delek US Holdings"), and matching only the
  /// canonical name silently misses most of them.
  aliases          String[]             @default([])
  linkedinUrl      String?
  website          String?
  companyId        String?
  /// Research output. Shape: TechRadarProfile in lib/tech-radar/types.ts
  profile          Json?
  /// Why research failed, when status is RESEARCH_FAILED.
  profileError     String?
  researchedAt     DateTime?
  lastScanAt       DateTime?
  /// Tiered-cadence lever: raise for PROSPECTs to halve scan cost at scale.
  scanIntervalDays Int                  @default(7)
  status           TrackedCompanyStatus @default(PENDING_RESEARCH)
  /// True when the row was created automatically from a contact's employer rather
  /// than hand-curated. v2 populates this list from contacts; v1 rows keep false.
  autoAdded        Boolean              @default(false)
  /// Headcount snapshot at population time, for the 50-200 gate. Snapshotted
  /// rather than read live so a cohort decision can be explained after the fact.
  staffCount       Int?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  org           Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company       Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunities TechOpportunity[]

  @@unique([orgId, name])
  @@index([status])
  @@index([orgId, status])
}

/// One newly-launched technology, written up once and shared across companies.
/// `dedupeKey` is derived from normalized vendor + technology (NOT url) so one
/// launch covered by three outlets collapses to a single row.
model TechItem {
  id          String    @id @default(cuid())
  vendor      String?
  technology  String
  title       String
  summary     String    @db.Text
  categories  String[]  @default([])
  /// [{ url, title, publishedAt }]
  sources     Json
  publishedAt DateTime?
  /// True when synthesized from a search snippet because no page could be read.
  thin        Boolean   @default(false)
  dedupeKey   String    @unique
  createdAt   DateTime  @default(now())

  opportunities TechOpportunity[]

  @@index([createdAt])
}

/// The per-company judgement on a TechItem. `fitRationale` — not the item
/// summary — is what feeds the outreach message.
model TechOpportunity {
  id                String                @id @default(cuid())
  itemId            String
  trackedCompanyId  String
  fitRationale      String                @db.Text
  /// Which of the company's business lines this belongs to. Persisted (not just used in
  /// the cap) so drafting can spread across lines instead of letting the highest scores
  /// spend the whole per-contact budget on one line.
  businessLine      String?
  /// When the org has nobody senior at this company: which role they should acquire.
  /// "No one to contact" is more useful as a recommendation than as a dead end.
  contactSuggestion String?               @db.Text
  /// WHY there is nobody to send to: no_senior_contact | no_role_match |
  /// contacts_at_capacity. The screen claimed "you have no senior contact here" for all
  /// three, which was false for two of them.
  blockReason       String?
  score             Float                 @default(0)
  status            TechOpportunityStatus @default(DISCOVERED)
  createdAt         DateTime              @default(now())

  item           TechItem               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  trackedCompany TrackedCompany         @relation(fields: [trackedCompanyId], references: [id], onDelete: Cascade)
  drafts         TechOpportunityDraft[]

  @@unique([trackedCompanyId, itemId])
  @@index([trackedCompanyId, status])
  @@index([status])
}

/// One prepared message to one contact. The system prepares; the human sends.
model TechOpportunityDraft {
  id              String          @id @default(cuid())
  opportunityId   String
  ownerId         String
  contactId       String
  draftMessage    String          @db.Text
  emailSubject    String?
  emailBody       String?         @db.Text
  whatsappMessage String?         @db.Text
  channel         String          @default("LINKEDIN")
  status          TechDraftStatus @default(PENDING_REVIEW)
  sentAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  opportunity TechOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  owner       User            @relation("UserTechOpportunityDrafts", fields: [ownerId], references: [id], onDelete: Cascade)
  contact     Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, contactId])
  @@index([ownerId, status])
}
