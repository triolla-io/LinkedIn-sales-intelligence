{
  "manifest_version": 3,
  "name": "Triolla LinkedIn Sender",
  "version": "0.6.7",
  "description": "Sends LinkedIn messages for Triolla campaigns",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "management"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://sales.triolla.io/*",
    "https://staging.triolla.io/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content.ts-loader-SqZ8D2mx.js"
      ],
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "resources": [
        "assets/resolve-company-L53-Bghy.js",
        "assets/content.ts-2WFk2Phf.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
