# Reinstalled/rebuilt inside the image — never send from the build context
node_modules
.next
.git

# Secrets & local env (Coolify injects env at runtime)
.env
.env.local
.env.*.local
.npmrc

# Test & tooling artifacts (not needed by build or runner)
tests
playwright.config.ts
playwright-report
test-results
vitest.config.ts
.pytest_cache
coverage
tsconfig.tsbuildinfo
debugScreenshot

# Docs & editor/agent noise
docs
*.md
.DS_Store
.github
.claude
.agents
.superpowers
.understand-anything
scratchpad

# Separate service with its own Dockerfile (Dockerfile.whatsapp). It builds
# from the repo root, so its sources must stay in the context — exclude only the
# rebuilt/stateful parts. Its src is a few KB, harmless in the app image.
whatsapp-service/node_modules
whatsapp-service/dist
whatsapp-service/whatsapp-sessions

# Docker meta (not needed inside the image)
Dockerfile*
docker-compose.yml
